<?xml version="1.0"?>
<robot
    xmlns:xacro="http://www.ros.org/wiki/xacro" name="dragon" >

  <!-- temporary -->
  <xacro:include filename="$(find dragon)/urdf/dragon_common.xacro" />
  <xacro:include filename="$(find dragon)/urdf/dragon_one_rotor_link.urdf.xacro" />

  <xacro:dragon_one_rotor_module self="1" child="2" baselink="false" />
  <xacro:dragon_one_rotor_module self="2" child="3" baselink="true" />
  <xacro:dragon_one_rotor_module self="3" child="4" baselink="false" />
  <xacro:dragon_one_rotor_module self="4" child="5" baselink="false" />
  <xacro:dragon_one_rotor_module self="5" child="6" baselink="false" />
  <xacro:dragon_one_rotor_module self="6" child="7" baselink="false" />
  <xacro:dragon_one_rotor_module self="7" child="8" baselink="false" />
  <xacro:dragon_one_rotor_module self="8" child="9" baselink="false" />
  <xacro:dragon_one_rotor_module self="9" child="10" baselink="false" />
  <xacro:dragon_one_rotor_module self="10" child="11" baselink="false" />
  <xacro:dragon_one_rotor_module self="11" child="12" baselink="false" />
  <xacro:dragon_one_rotor_module self="12" child="13" baselink="false" />
  <xacro:dragon_one_rotor_module self="13" child="14" baselink="false" />
  <xacro:dragon_one_rotor_module self="14" child="15" baselink="false" />
  <xacro:dragon_one_rotor_module self="15" child="16" baselink="false" />
  <xacro:dragon_one_rotor_module self="16" child="16" baselink="false" />

</robot>
