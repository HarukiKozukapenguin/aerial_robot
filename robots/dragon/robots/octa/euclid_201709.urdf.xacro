<?xml version="1.0"?>
<robot
    xmlns:xacro="http://www.ros.org/wiki/xacro" name="dragon" >

  <!-- temporary -->
  <xacro:include filename="$(find dragon)/urdf/dragon_common.xacro" />
  <xacro:include filename="$(find dragon)/urdf/dragon_spine_based_link.urdf.xacro" />

  <xacro:dragon_one_rotor_module self="1" child="2" baselink="false" pitch=".50" yaw=".15"/>
  <xacro:dragon_one_rotor_module self="2" child="3" baselink="true" pitch=".50" yaw=".15"/>
  <xacro:dragon_one_rotor_module self="3" child="4" baselink="false" pitch=".50" yaw=".15"/>
  <xacro:dragon_one_rotor_module self="4" child="5" baselink="false" pitch=".50" yaw=".15"/>
  <xacro:dragon_one_rotor_module self="5" child="6" baselink="false" pitch=".0" yaw="-.05"/>
  <xacro:dragon_one_rotor_module self="6" child="7" baselink="false" pitch=".0" yaw="-.05"/>
  <xacro:dragon_one_rotor_module self="7" child="8" baselink="false" pitch="0" yaw="-.05"/>
  <xacro:dragon_one_rotor_module self="8" child="8" baselink="false" pitch=".0" yaw=".0"/>

</robot>
